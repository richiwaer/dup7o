
<!DOCTYPE html>
<html lang="de">

<head>
    <!-- ========================================
         1. GRUNDEINSTELLUNGEN
    ========================================= -->

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#080d19">

    <title>DUP7O — Gaming & Community</title>


    <!-- ========================================
         2. CSS / DESIGN
    ========================================= -->

    <style>

        /* ----------------------------------------
           2.1 FARBEN UND GRUNDEINSTELLUNGEN
        ---------------------------------------- */

        :root {
            --bg: #080d19;
            --panel: #101a2c;
            --panel2: #14223a;

            --blue: #4169ff;
            --blue2: #7095ff;

            --text: #f4f7ff;
            --muted: #a6b6d1;

            --line: rgba(145, 170, 220, .16);

            --max: 1160px;
        }


        /* ----------------------------------------
           2.2 ALLGEMEINE EINSTELLUNGEN
        ---------------------------------------- */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);

            font-family: Inter, ui-sans-serif, system-ui,
                         -apple-system, "Segoe UI", sans-serif;

            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        a {
            -webkit-tap-highlight-color: transparent;
        }

        .wrap {
            width: min(var(--max), calc(100% - 44px));
            margin: auto;
        }


        /* ----------------------------------------
           2.3 NAVIGATION / HEADER
        ---------------------------------------- */

        header {
            position: sticky;
            top: 0;
            z-index: 20;

            background: rgba(8, 13, 25, .88);
            backdrop-filter: blur(16px);

            border-bottom: 1px solid var(--line);
        }

        .nav {
            height: 76px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 24px;
        }

        /* DUP7O LOGO */

        .logo {
            font-weight: 950;
            letter-spacing: -.075em;
            font-size: 29px;
            line-height: 1;
        }

        .logo span {
            color: var(--blue2);
        }

        /* NAVIGATION LINKS */

        .navlinks {
            display: flex;
            align-items: center;
            gap: 27px;

            color: #c6d2e7;

            font-size: 13px;
            font-weight: 750;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .navlinks a {
            transition: .2s;
        }

        .navlinks a:hover {
            color: var(--blue2);
        }

        /* DISCORD BUTTON */

        .nav-cta,
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;

            border-radius: 10px;
            padding: 12px 18px;

            font-weight: 850;
            font-size: 13px;
            letter-spacing: .045em;

            transition: transform .2s,
                        box-shadow .2s,
                        background .2s;
        }

        .nav-cta,
        .btn-primary {
            background: linear-gradient(135deg, #4169ff, #2850e8);
            color: white;

            box-shadow: 0 8px 28px rgba(65, 105, 255, .23);
        }

        .nav-cta:hover,
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(65, 105, 255, .32);
        }

        /* MOBILE MENU BUTTON */

        .menu {
            display: none;

            background: none;
            border: 1px solid var(--line);

            color: white;
            border-radius: 9px;

            padding: 9px 12px;
            font-size: 20px;
        }


        /* ----------------------------------------
           2.4 HERO / STARTBEREICH
        ---------------------------------------- */

        .hero {
            position: relative;
            overflow: hidden;

            min-height: 610px;

            display: grid;
            place-items: center;

            text-align: center;

            border-bottom: 1px solid var(--line);
            isolation: isolate;
        }

        /* Hintergrund-Effekte */

        .hero:before,
        .hero:after {
            content: "";
            position: absolute;
            z-index: -1;
            pointer-events: none;
        }

        .hero:before {
            width: 680px;
            height: 500px;

            left: 50%;
            top: 45%;

            transform: translate(-50%, -50%);

            background: radial-gradient(
                ellipse,
                rgba(47, 91, 255, .22),
                transparent 68%
            );

            filter: blur(12px);
        }

        .hero:after {
            inset: 0;

            background:
                linear-gradient(
                    120deg,
                    transparent 0 35%,
                    rgba(72, 117, 255, .06) 48%,
                    transparent 62%
                ),
                radial-gradient(
                    circle at 12% 25%,
                    rgba(75, 117, 255, .10),
                    transparent 23%
                ),
                radial-gradient(
                    circle at 88% 72%,
                    rgba(75, 117, 255, .09),
                    transparent 25%
                );
        }

        .hero-inner {
            padding: 100px 0 112px;
            position: relative;
        }

        /* KLEINES LABEL ÜBER DER ÜBERSCHRIFT */

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 7px 12px;

            border: 1px solid rgba(112, 149, 255, .32);
            border-radius: 999px;

            background: rgba(65, 105, 255, .09);
            color: #b9caff;

            font-size: 11px;
            font-weight: 850;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;
            background: #7095ff;

            box-shadow: 0 0 13px #7095ff;
        }

        /* HAUPTÜBERSCHRIFT */

        h1 {
            font-size: clamp(48px, 8vw, 92px);
            line-height: .98;
            letter-spacing: -.065em;

            margin: 27px 0 20px;
            font-weight: 950;
        }

        /* BLAUER TEXTVERLAUF */

        .gradient {
            background: linear-gradient(
                100deg,
                #fff 5%,
                #a9bdff 42%,
                #5680ff 82%
            );

            -webkit-background-clip: text;
            background-clip: text;

            color: transparent;
        }

        .hero p {
            max-width: 650px;
            margin: 0 auto;

            color: var(--muted);
            font-size: clamp(15px, 2vw, 18px);
        }


        /* ----------------------------------------
           2.5 BUTTONS IM HERO-BEREICH
        ---------------------------------------- */

        .actions {
            display: flex;
            justify-content: center;
            gap: 13px;
            flex-wrap: wrap;

            margin-top: 32px;
        }

        .btn {
            padding: 15px 21px;
            border: 1px solid transparent;
        }

        .btn-outline {
            border-color: rgba(166, 182, 209, .27);

            background: rgba(255, 255, 255, .025);
            color: #e7edfa;
        }

        .btn-outline:hover {
            background: rgba(255, 255, 255, .07);
        }

        .hero-note {
            margin-top: 54px;

            color: #70819f;

            font-size: 11px;
            letter-spacing: .19em;
            text-transform: uppercase;
        }


        /* ----------------------------------------
           2.6 ALLGEMEINE SEKTIONEN
        ---------------------------------------- */

        section {
            padding: 92px 0;
        }

        .section-head {
            display: flex;
            align-items: end;
            justify-content: space-between;

            gap: 24px;
            margin-bottom: 30px;
        }

        .kicker {
            color: var(--blue2);

            font-size: 11px;
            font-weight: 900;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

        h2 {
            font-size: clamp(30px, 4vw, 45px);
            letter-spacing: -.045em;
            line-height: 1.1;

            margin: 9px 0 0;
        }

        .section-head p {
            max-width: 430px;

            color: var(--muted);
            margin: 0;

            font-size: 14px;
        }


        /* ----------------------------------------
           2.7 GAMING-KARTEN
        ---------------------------------------- */

        .games {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .game-card {
            position: relative;
            overflow: hidden;

            min-height: 330px;

            border: 1px solid var(--line);
            border-radius: 18px;

            background: linear-gradient(
                145deg,
                #142849,
                #0d1525 72%
            );

            padding: 28px;

            display: flex;
            flex-direction: column;
            justify-content: end;

            isolation: isolate;

            transition: transform .25s, border-color .25s;
        }

        .game-card:hover {
            transform: translateY(-5px);
            border-color: rgba(112, 149, 255, .55);
        }

        /* HINTERGRUND DER GAMING-KARTEN */

        .game-card:before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            opacity: .9;
        }

        /* MINECRAFT */

        .minecraft:before {
            background:
                radial-gradient(
                    circle at 75% 20%,
                    rgba(91, 145, 255, .36),
                    transparent 34%
                ),
                linear-gradient(
                    135deg,
                    transparent 20%,
                    rgba(36, 79, 150, .32)
                ),
                repeating-linear-gradient(
                    90deg,
                    transparent 0 48px,
                    rgba(140, 174, 255, .035) 49px 50px
                );
        }

        /* FIVEM */

        .fivem:before {
            background:
                radial-gradient(
                    circle at 78% 18%,
                    rgba(65, 105, 255, .35),
                    transparent 32%
                ),
                linear-gradient(
                    150deg,
                    rgba(24, 49, 88, .2),
                    transparent 55%
                ),
                repeating-linear-gradient(
                    0deg,
                    transparent 0 42px,
                    rgba(140, 174, 255, .035) 43px 44px
                );
        }

        /* SYMBOL OBEN RECHTS */

        .game-symbol {
            position: absolute;
            right: 28px;
            top: 25px;

            font-size: 66px;
            opacity: .22;

            filter: drop-shadow(0 0 25px #4169ff);
        }

        .card-tag {
            color: #9eb7ff;

            font-size: 10px;
            font-weight: 900;
            letter-spacing: .17em;
            text-transform: uppercase;
        }

        .game-card h3 {
            font-size: 30px;
            letter-spacing: -.04em;

            margin: 7px 0;
        }

        .game-card p {
            color: #b2c0d8;

            max-width: 370px;
            margin: 0 0 20px;

            font-size: 14px;
        }

        .text-link {
            font-size: 12px;
            color: #c8d6ff;

            font-weight: 900;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .text-link b {
            color: var(--blue2);
            font-size: 17px;
            margin-left: 7px;
        }


        /* ----------------------------------------
           2.8 DOWNLOADS / RESOURCE-KARTEN
        ---------------------------------------- */

        .resources {
            background: linear-gradient(
                180deg,
                transparent,
                rgba(18, 31, 54, .48),
                transparent
            );
        }

        .resource-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 15px;
        }

        .resource {
            padding: 24px;

            border: 1px solid var(--line);
            border-radius: 15px;

            background: linear-gradient(
                145deg,
                rgba(19, 34, 58, .9),
                rgba(12, 20, 35, .9)
            );

            transition: .2s;
        }

        .resource:hover {
            border-color: rgba(112, 149, 255, .5);
            transform: translateY(-3px);
        }

        /* ICON DER RESOURCE-KARTEN */

        .icon {
            width: 43px;
            height: 43px;

            display: grid;
            place-items: center;

            border-radius: 12px;

            background: rgba(65, 105, 255, .13);
            color: #91acff;

            font-size: 20px;
            margin-bottom: 18px;
        }

        .resource h3 {
            margin: 0 0 7px;
            font-size: 17px;
        }

        .resource p {
            margin: 0 0 18px;

            color: var(--muted);
            font-size: 13px;
        }


        /* ----------------------------------------
           2.9 COMMUNITY-BEREICH
        ---------------------------------------- */

        .community {
            padding: 0 0 95px;
        }

        .community-box {
            position: relative;
            overflow: hidden;

            text-align: center;

            border: 1px solid rgba(112, 149, 255, .24);
            border-radius: 22px;

            padding: 65px 25px;

            background:
                radial-gradient(
                    ellipse at 50% 0%,
                    rgba(65, 105, 255, .2),
                    transparent 62%
                ),
                linear-gradient(
                    135deg,
                    #111e34,
                    #0b1322
                );
        }

        .community-box h2 {
            margin: 13px 0;
        }

        .community-box p {
            max-width: 580px;
            margin: 0 auto;

            color: var(--muted);
        }


        /* ----------------------------------------
           2.10 FOOTER / FUßBEREICH
        ---------------------------------------- */

        footer {
            border-top: 1px solid var(--line);

            padding: 28px 0 35px;

            color: #8392ad;
            font-size: 12px;
        }

        .footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;
        }

        .footer-links {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .footer-links a:hover {
            color: #fff;
        }

        .small-logo {
            font-size: 21px;
            color: #fff;

            font-weight: 950;
            letter-spacing: -.07em;
        }

        .small-logo span {
            color: var(--blue2);
        }


        /* ========================================
           3. RESPONSIVE DESIGN / HANDY
        ========================================= */

        @media (max-width: 760px) {

            .wrap {
                width: min(100% - 30px, var(--max));
            }

            /* MOBILE NAVIGATION */

            .nav {
                height: 66px;
            }

            .navlinks {
                display: none;

                position: absolute;
                top: 66px;
                left: 0;
                right: 0;

                padding: 20px 22px;

                background: #0b1322;
                border-bottom: 1px solid var(--line);

                flex-direction: column;
                align-items: flex-start;
                gap: 18px;
            }

            .navlinks.open {
                display: flex;
            }

            .nav-cta {
                display: none;
            }

            .menu {
                display: block;
            }

            /* HERO */

            .hero {
                min-height: 540px;
            }

            .hero-inner {
                padding: 82px 0;
            }

            /* SEKTIONEN */

            section {
                padding: 68px 0;
            }

            .section-head {
                display: block;
            }

            .section-head p {
                margin-top: 13px;
            }

            /* GAMING */

            .games {
                grid-template-columns: 1fr;
            }

            .game-card {
                min-height: 285px;
            }

            /* DOWNLOADS */

            .resource-grid {
                grid-template-columns: 1fr;
            }

            /* FOOTER */

            .footer-inner {
                flex-direction: column;
                align-items: flex-start;
            }
        }

    </style>
</head>


